{
  "name": "flight-watch",
  "private": true,
  "scripts": {
    "build": "esbuild src/entry.jsx --bundle --minify --outfile=bundle.js --jsx=automatic --loader:.jsx=jsx --define:process.env.NODE_ENV=\"'production'\"",
    "dev": "npm run build && wrangler pages dev .",
    "verify-deals": "node scripts/verify-deals.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "wrangler": "^3.90.0",
    "playwright": "^1.47.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
